# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# MongoDB Atlas connection string
# Free tier: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/

# Database name — separate from your other agent-memory-graph DB
DB_NAME=multi_agent_debugger
# How long to wait for Mongo before giving up (milliseconds)
MONGO_TIMEOUT_MS=5000

# LLM model — change without code changes
LLM_MODEL=gemini-2.5-flash

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Log output: pretty (dev console) or json (production)
LOG_FORMAT=pretty

# How many past similar bugs to retrieve from the graph per agent
MEMORY_RETRIEVAL_LIMIT=5